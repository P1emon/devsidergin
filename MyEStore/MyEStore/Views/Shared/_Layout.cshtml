<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SIDERGIN - Chăm sóc sức khỏe</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
</head>
<body class="min-h-screen bg-gray-100">
    <!-- Header -->
    <header class="bg-white shadow-lg">
        <div class="bg-gradient-to-r from-blue-700 to-indigo-700 px-6 py-4">
            <div class="max-w-7xl mx-auto flex justify-between items-center">
                <div class="logo">
                    <a asp-area="" asp-controller="Home" asp-action="Index" class="text-2xl font-semibold text-white">
                        <span class="text-yellow-300">S</span>idergin
                    </a>
                </div>
                <nav>
                    <ul class="flex space-x-6 items-center">
                        <li>
                            <a asp-area="" asp-controller="Slider" asp-action="Index" class="text-white hover:text-gray-200 transition-colors">
                                <i class="fas fa-newspaper mr-1"></i> Slider
                            </a>
                        </li>
                        <li>
                            <a asp-area="" asp-controller="Supplier" asp-action="Index" class="text-white hover:text-gray-200 transition-colors">
                                <i class="fas fa-newspaper mr-1"></i> Nhà cung cấp
                            </a>
                        </li>
                        <li>
                            <a asp-controller="Loai" asp-action="Index" class="text-white hover:text-gray-200 transition-colors">
                                <i class="fas fa-bell mr-1"></i> Loại
                            </a>
                        </li>
                        <li>
                            <a asp-area="" asp-controller="Product" asp-action="Index" class="text-white hover:text-gray-200 transition-colors">
                                <i class="fas fa-cart-plus mr-1"></i> Hàng hoá
                            </a>
                        </li>
                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="relative">
                                <a href="#" class="dropdown-toggle text-white hover:text-gray-200 transition-colors flex items-center" data-toggle="dropdown">
                                    <i class="fas fa-user-circle mr-1"></i>
                                    @if (User.Claims.Any(c => c.Type == "RankIcon" && !string.IsNullOrEmpty(c.Value)))
                                    {
                                        <img src="~/Hinh/Others/@User.Claims.First(c => c.Type == "RankIcon").Value" alt="Rank Icon" class="w-8 h-8 mr-2 rounded-full" />
                                    }
                                    <span class="font-medium">@User.Identity.Name</span>
                                    <i class="fas fa-chevron-down ml-1"></i>
                                </a>
                                <ul class="dropdown-menu absolute hidden bg-white shadow-lg rounded-lg mt-2 w-48 z-10">
                                    <li>
                                        <a asp-area="" asp-controller="Employee" asp-action="Logout" class="block px-4 py-2 text-red-600 hover:bg-gray-100">
                                            <i class="fas fa-sign-out-alt mr-1"></i> Đăng xuất
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li>
                                <a asp-area="" asp-controller="Employee" asp-action="Register" class="text-white hover:text-gray-200 transition-colors">
                                    <i class="fas fa-user-plus mr-1"></i> Đăng ký
                                </a>
                            </li>
                            <li>
                                <a asp-area="" asp-controller="Employee" asp-action="Login" class="text-white hover:text-gray-200 transition-colors">
                                    <i class="fas fa-sign-in-alt mr-1"></i> Đăng nhập
                                </a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <div class="max-w-7xl mx-auto py-8 px-4 sm:px-6 lg:px-8">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/jquery@3.6.0/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        $(document).ready(function() {
            // Toggle dropdown on click
            $('.dropdown-toggle').on('click', function(e) {
                e.preventDefault();
                $(this).next('.dropdown-menu').toggleClass('hidden');
            });

            // Close dropdown when clicking outside
            $(document).on('click', function(e) {
                if (!$(e.target).closest('.dropdown-toggle').length && !$(e.target).closest('.dropdown-menu').length) {
                    $('.dropdown-menu').addClass('hidden');
                }
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>