@model DevSidergin.Entities.ThongBao
@{
    ViewData["Title"] = "Sửa thông báo";
}

<div class="min-h-screen bg-gray-100 py-8 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
        <!-- Header -->
        <div class="bg-white shadow-lg rounded-xl overflow-hidden mb-6">
            <div class="bg-gradient-to-r from-blue-700 to-indigo-700 px-6 py-4">
                <h1 class="text-2xl font-semibold text-white text-center">
                    <i class="fas fa-edit mr-2"></i>Sửa thông báo
                </h1>
            </div>
        </div>

        <!-- Form -->
        <div class="bg-white shadow-lg rounded-xl p-6">
            <form asp-action="Edit" method="post" class="space-y-6">
                <input type="hidden" asp-for="MaTb" />
                <div asp-validation-summary="ModelOnly" class="text-red-600 text-sm"></div>

                <!-- Title -->
                <div>
                    <label asp-for="TieuDe" class="block text-sm font-medium text-gray-700">Tiêu đề <span class="text-red-500">*</span></label>
                    <input asp-for="TieuDe" class="w-full px-3 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 bg-gray-50 text-sm" placeholder="Nhập tiêu đề thông báo" required />
                    <span asp-validation-for="TieuDe" class="text-red-600 text-xs"></span>
                </div>

                <!-- Content -->
                <div>
                    <label asp-for="NoiDung" class="block text-sm font-medium text-gray-700">Nội dung <span class="text-red-500">*</span></label>
                    <textarea asp-for="NoiDung" rows="4" class="w-full px-3 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 bg-gray-50 text-sm" placeholder="Nhập nội dung thông báo" required></textarea>
                    <span asp-validation-for="NoiDung" class="text-red-600 text-xs"></span>
                </div>

                <!-- Hidden Fields -->
                <input type="hidden" asp-for="MaSlider" />
                <input type="hidden" asp-for="MaKh" />
                <input type="hidden" asp-for="MaMv" />
                <input type="hidden" asp-for="NgayTao" />

                <!-- Submit Button -->
                <div class="flex justify-end">
                    <button type="submit" class="inline-flex items-center px-4 py-2 rounded-lg bg-blue-600 text-white hover:bg-blue-700 transition-colors text-sm">
                        <i class="fas fa-save mr-2"></i>Lưu thay đổi
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
} 