@{
    ViewData["Title"] = "Privacy Policy";
    var hostName = "https://localhost:7238/";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MyEStore</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet" />
</head>
<body class="min-h-screen bg-gray-100 py-8 px-4 sm:px-6 lg:px-8">
    <div class="max-w-5xl mx-auto">
        <div class="bg-white shadow-lg rounded-xl overflow-hidden">
            <!-- Header -->
            <div class="bg-gradient-to-r from-blue-700 to-indigo-700 px-6 py-4">
                <h1 class="text-2xl font-semibold text-white text-center">
                    <i class="fas fa-shield-alt mr-2"></i>Privacy Policy
                </h1>
                <p class="text-sm text-blue-200 text-center mt-1">
                    Your trust matters to us. Learn how MyEStore protects your personal information.
                </p>
            </div>

            <!-- Content -->
            <div class="p-4 sm:p-6">
                <!-- Section 1: Information We Collect -->
                <div class="bg-white p-4 rounded-lg shadow-sm border border-gray-100 mb-4">
                    <h2 class="text-lg font-semibold text-gray-800 mb-3">
                        <i class="fas fa-user-shield mr-2 text-blue-600"></i>Information We Collect
                    </h2>
                    <p class="text-sm text-gray-600 mb-3">
                        We gather data to enhance your shopping experience and provide quality services:
                    </p>
                    <ul class="list-disc pl-5 text-sm text-gray-600 space-y-2">
                        <li><strong>Personal Information:</strong> Name, email, phone number, and billing/shipping addresses provided during registration or checkout.</li>
                        <li><strong>Account Details:</strong> Login credentials, preferences, and settings stored in your MyEStore account.</li>
                        <li><strong>Transaction Data:</strong> Order history, payment details (securely processed via PayPal), and delivery information.</li>
                        <li><strong>Usage Data:</strong> Browsing patterns, IP address, device type, and site interactions.</li>
                        <li><strong>Cookies:</strong> Data files that improve functionality, like saving your cart or preferences.</li>
                    </ul>
                </div>

                <!-- Section 2: How We Use Your Information -->
                <div class="bg-white p-4 rounded-lg shadow-sm border border-gray-100 mb-4">
                    <h2 class="text-lg font-semibold text-gray-800 mb-3">
                        <i class="fas fa-cogs mr-2 text-blue-600"></i>How We Use Your Information
                    </h2>
                    <p class="text-sm text-gray-600 mb-3">
                        We use your data to deliver a seamless and personalized experience:
                    </p>
                    <ul class="list-disc pl-5 text-sm text-gray-600 space-y-2">
                        <li>Process orders, send confirmations, and manage deliveries.</li>
                        <li>Tailor recommendations based on your browsing and purchase history.</li>
                        <li>Analyze site usage to improve our services and user experience.</li>
                        <li>Send promotional offers or updates (with your consent).</li>
                        <li>Protect against fraud and secure your account.</li>
                    </ul>
                </div>

                <!-- Section 3: Sharing Your Information -->
                <div class="bg-white p-4 rounded-lg shadow-sm border border-gray-100 mb-4">
                    <h2 class="text-lg font-semibold text-gray-800 mb-3">
                        <i class="fas fa-share-alt mr-2 text-blue-600"></i>Sharing Your Information
                    </h2>
                    <p class="text-sm text-gray-600 mb-3">
                        We share data only when necessary and with trusted parties:
                    </p>
                    <ul class="list-disc pl-5 text-sm text-gray-600 space-y-2">
                        <li><strong>Service Providers:</strong> Partners for payment (e.g., PayPal), shipping, or support, under strict confidentiality.</li>
                        <li><strong>Legal Requirements:</strong> To comply with laws or protect MyEStore’s rights, like responding to legal requests.</li>
                        <li><strong>Business Changes:</strong> During mergers or acquisitions, with your consent.</li>
                    </ul>
                    <p class="text-sm text-gray-600 mt-3">
                        We do not sell your personal information to third parties.
                    </p>
                </div>

                <!-- Section 4: Your Rights and Choices -->
                <div class="bg-white p-4 rounded-lg shadow-sm border border-gray-100 mb-4">
                    <h2 class="text-lg font-semibold text-gray-800 mb-3">
                        <i class="fas fa-user-check mr-2 text-blue-600"></i>Your Rights and Choices
                    </h2>
                    <p class="text-sm text-gray-600 mb-3">
                        You have control over your data and can:
                    </p>
                    <ul class="list-disc pl-5 text-sm text-gray-600 space-y-2">
                        <li>View or edit your profile at <a href="@hostName/Customer/Profile" class="text-blue-600 hover:underline">MyEStore account</a>.</li>
                        <li>Request data deletion by contacting us (subject to legal obligations).</li>
                        <li>Opt out of marketing emails via unsubscribe links.</li>
                        <li>Control cookies through browser settings or our consent tool.</li>
                    </ul>
                    <p class="text-sm text-gray-600 mt-3">
                        Additional rights (e.g., data portability) may apply in regions like the EU or California.
                    </p>
                </div>

                <!-- Section 5: Cookies and Tracking -->
                <div class="bg-white p-4 rounded-lg shadow-sm border border-gray-100 mb-4">
                    <h2 class="text-lg font-semibold text-gray-800 mb-3">
                        <i class="fas fa-cookie-bite mr-2 text-blue-600"></i>Cookies and Tracking
                    </h2>
                    <p class="text-sm text-gray-600 mb-3">
                        We use cookies to improve your experience:
                    </p>
                    <ul class="list-disc pl-5 text-sm text-gray-600 space-y-2">
                        <li><strong>Essential Cookies:</strong> Enable core features like cart and login.</li>
                        <li><strong>Analytics Cookies:</strong> Track site usage for improvements.</li>
                        <li><strong>Advertising Cookies:</strong> Support personalized ads (optional).</li>
                    </ul>
                    <p class="text-sm text-gray-600 mt-3">
                        Disabling cookies may affect site functionality.
                    </p>
                </div>

                <!-- Section 6: Data Security -->
                <div class="bg-white p-4 rounded-lg shadow-sm border border-gray-100 mb-4">
                    <h2 class="text-lg font-semibold text-gray-800 mb-3">
                        <i class="fas fa-lock mr-2 text-blue-600"></i>Data Security
                    </h2>
                    <p class="text-sm text-gray-600 mb-3">
                        We safeguard your data with:
                    </p>
                    <ul class="list-disc pl-5 text-sm text-gray-600 space-y-2">
                        <li>SSL/TLS encryption for sensitive information.</li>
                        <li>Regular system audits and updates.</li>
                        <li>Limited access to data by authorized staff only.</li>
                    </ul>
                    <p class="text-sm text-gray-600 mt-3">
                        Please protect your account credentials, as no system is fully secure.
                    </p>
                </div>

                <!-- Section 7: International Data Transfers -->
                <div class="bg-white p-4 rounded-lg shadow-sm border border-gray-100 mb-4">
                    <h2 class="text-lg font-semibold text-gray-800 mb-3">
                        <i class="fas fa-globe mr-2 text-blue-600"></i>International Data Transfers
                    </h2>
                    <p class="text-sm text-gray-600">
                        Your data may be transferred globally (e.g., for hosting or payments). We comply with laws like GDPR or CCPA, using safeguards such as standard contractual clauses.
                    </p>
                </div>

                <!-- Section 8: Changes to This Policy -->
                <div class="bg-white p-4 rounded-lg shadow-sm border border-gray-100 mb-4">
                    <h2 class="text-lg font-semibold text-gray-800 mb-3">
                        <i class="fas fa-file-alt mr-2 text-blue-600"></i>Changes to This Policy
                    </h2>
                    <p class="text-sm text-gray-600">
                        We may revise this policy to reflect new practices or laws. Updates will be posted here, with major changes notified via email or site notice. Check back regularly.
                    </p>
                </div>

                <!-- Contact Card -->
                <div class="bg-blue-600 p-4 rounded-lg shadow-sm text-center text-white">
                    <h3 class="text-lg font-semibold mb-3">Contact Us</h3>
                    <p class="text-sm mb-2">
                        For questions about your privacy, reach out to our team:
                    </p>
                    <p class="text-sm mb-2">
                        Email: <a href="mailto:privacy@myestore.com" class="text-blue-200 hover:underline">privacy@myestore.com</a>
                    </p>
                    <p class="text-sm mb-2">
                        Phone: <a href="tel:+8423456789" class="text-blue-200 hover:underline">+84 234 567 89</a>
                    </p>
                    <p class="text-sm">
                        Address: 123 Đường Số 1, Quận 1, TP. Hồ Chí Minh, Việt Nam
                    </p>
                </div>

                <!-- Last Updated -->
                <div class="text-center text-xs text-gray-500 mt-4">
                    Last updated: April 18, 2025
                </div>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
</body>
</html>