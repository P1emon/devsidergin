@model MyEStore.Entities.HoaDon

@{
    ViewData["Title"] = "Cập nhật trạng thái đơn hàng";
}

<div class="min-h-screen bg-gray-100 py-8 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
        <!-- Header -->
        <div class="bg-white shadow-lg rounded-xl overflow-hidden mb-6">
            <div class="bg-gradient-to-r from-blue-700 to-indigo-700 px-6 py-4">
                <h1 class="text-2xl font-semibold text-white text-center">
                    <i class="fas fa-edit mr-2"></i>Cập nhật trạng thái đơn hàng #@Model.MaHd
                </h1>
            </div>
        </div>

        <!-- Alert -->
        @if (TempData["ThongBao"] != null)
        {
            <div class="bg-green-100 border-l-4 border-green-500 text-green-700 p-4 rounded-lg mb-6 relative">
                @TempData["ThongBao"]
                <button type="button" class="absolute top-0 right-0 mt-4 mr-4 text-green-700 hover:text-green-900" data-bs-dismiss="alert" aria-label="Close">
                    <i class="fas fa-times"></i>
                </button>
            </div>
        }

        <!-- Content -->
        <div class="bg-white shadow-lg rounded-xl p-6">
            <form asp-action="UpdateStatus" class="space-y-6">
                <input type="hidden" asp-for="MaHd" />
                <div asp-validation-summary="ModelOnly" class="text-red-600 text-sm"></div>

                <div>
                    <label asp-for="MaTrangThai" class="block text-sm font-medium text-gray-700">Trạng thái</label>
                    <select asp-for="MaTrangThai" class="mt-1 block w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" asp-items="@(new SelectList(ViewData["TrangThai"] as List<MyEStore.Entities.TrangThai>, "MaTrangThai", "TenTrangThai"))"></select>
                    <span asp-validation-for="MaTrangThai" class="text-red-600 text-sm"></span>
                </div>

                <div>
                    <label asp-for="NgayHuy" class="block text-sm font-medium text-gray-700">Ngày hủy</label>
                    <input asp-for="NgayHuy" class="mt-1 block w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" type="date" />
                    <span asp-validation-for="NgayHuy" class="text-red-600 text-sm"></span>
                </div>

                <div>
                    <label asp-for="LyDo" class="block text-sm font-medium text-gray-700">Lý do hủy</label>
                    <textarea asp-for="LyDo" class="mt-1 block w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" rows="4"></textarea>
                    <span asp-validation-for="LyDo" class="text-red-600 text-sm"></span>
                </div>

                <div class="flex justify-end space-x-4">
                    <button type="submit" class="inline-flex items-center px-4 py-2 rounded-lg bg-blue-600 text-white hover:bg-blue-700 transition-colors text-sm">
                        <i class="fas fa-save mr-2"></i>Cập nhật
                    </button>
                    <a asp-action="Index" class="inline-flex items-center px-4 py-2 rounded-lg bg-gray-600 text-white hover:bg-gray-700 transition-colors text-sm">
                        <i class="fas fa-arrow-left mr-2"></i>Quay lại danh sách
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}