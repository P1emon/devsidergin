@model IEnumerable<MyEStore.Entities.Loai>

@{
    ViewData["Title"] = "Quản lý loại hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="min-h-screen bg-gray-100 py-8 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
        <!-- Header -->
        <div class="bg-white shadow-lg rounded-xl overflow-hidden mb-6">
            <div class="bg-gradient-to-r from-blue-700 to-indigo-700 px-6 py-4">
                <h1 class="text-2xl font-semibold text-white text-center">
                    <i class="fas fa-list mr-2"></i>Quản lý loại hàng
                </h1>
            </div>
        </div>

        <!-- Alert -->
        @if (TempData["success"] != null)
        {
            <div class="bg-green-100 border-l-4 border-green-500 text-green-700 p-4 rounded-lg mb-6 relative">
                @TempData["success"]
                <button type="button" class="absolute top-0 right-0 mt-4 mr-4 text-green-700 hover:text-green-900" data-bs-dismiss="alert" aria-label="Close">
                    <i class="fas fa-times"></i>
                </button>
            </div>
        }
        @if (TempData["error"] != null)
        {
            <div class="bg-red-100 border-l-4 border-red-500 text-red-700 p-4 rounded-lg mb-6 relative">
                @TempData["error"]
                <button type="button" class="absolute top-0 right-0 mt-4 mr-4 text-red-700 hover:text-red-900" data-bs-dismiss="alert" aria-label="Close">
                    <i class="fas fa-times"></i>
                </button>
            </div>
        }

        <!-- Content -->
        <div class="bg-white shadow-lg rounded-xl p-6">
            <div class="flex justify-end mb-4">
                <a asp-action="Create" class="inline-flex items-center px-4 py-2 rounded-lg bg-blue-600 text-white hover:bg-blue-700 transition-colors text-sm">
                    <i class="fas fa-plus mr-2"></i>Thêm loại hàng
                </a>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-sm text-left text-gray-700">
                    <thead class="text-xs text-gray-700 uppercase bg-gray-50">
                        <tr>
                            <th class="px-4 py-3">Mã loại</th>
                            <th class="px-4 py-3">Tên loại</th>
                            <th class="px-4 py-3">Tên alias</th>
                            <th class="px-4 py-3">Hình ảnh</th>
                            <th class="px-4 py-3">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr class="bg-white border-b hover:bg-gray-50">
                                <td class="px-4 py-3">@item.MaLoai</td>
                                <td class="px-4 py-3">@item.TenLoai</td>
                                <td class="px-4 py-3">@item.TenLoaiAlias</td>
                                <td class="px-4 py-3">
                                    @if (!string.IsNullOrEmpty(item.Hinh))
                                    {
                                        <img src="~/images/categories/@item.Hinh" alt="@item.TenLoai" class="max-w-[100px] h-auto rounded" />
                                    }
                                    else
                                    {
                                        <span class="text-gray-500">Chưa có hình</span>
                                    }
                                </td>
                                <td class="px-4 py-3">
                                    <a asp-action="Details" asp-route-id="@item.MaLoai" class="inline-flex items-center px-3 py-1.5 rounded-lg bg-blue-600 text-white hover:bg-blue-700 transition-colors text-sm mr-2">
                                        <i class="fas fa-eye mr-1"></i> Chi tiết
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.MaLoai" class="inline-flex items-center px-3 py-1.5 rounded-lg bg-yellow-500 text-white hover:bg-yellow-600 transition-colors text-sm mr-2">
                                        <i class="fas fa-edit mr-1"></i> Sửa
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.MaLoai" class="inline-flex items-center px-3 py-1.5 rounded-lg bg-red-600 text-white hover:bg-red-700 transition-colors text-sm">
                                        <i class="fas fa-trash mr-1"></i> Xóa
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
}