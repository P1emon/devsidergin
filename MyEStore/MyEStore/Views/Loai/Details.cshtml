@model MyEStore.Entities.Loai

@{
    ViewData["Title"] = "Chi tiết loại hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="min-h-screen bg-gray-100 py-8 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
        <!-- Header -->
        <div class="bg-white shadow-lg rounded-xl overflow-hidden mb-6">
            <div class="bg-gradient-to-r from-blue-700 to-indigo-700 px-6 py-4">
                <h1 class="text-2xl font-semibold text-white text-center">
                    <i class="fas fa-info-circle mr-2"></i>Chi tiết loại hàng
                </h1>
            </div>
        </div>

        <!-- Content -->
        <div class="bg-white shadow-lg rounded-xl p-6">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                <!-- Thông tin chi tiết -->
                <div>
                    <h2 class="text-lg font-semibold text-gray-900 mb-4">Thông tin chi tiết</h2>
                    <div class="space-y-4">
                        <div>
                            <dt class="text-sm font-medium text-gray-500">Mã loại</dt>
                            <dd class="mt-1 text-sm text-gray-900">@Model.MaLoai</dd>
                        </div>
                        <div>
                            <dt class="text-sm font-medium text-gray-500">Tên loại</dt>
                            <dd class="mt-1 text-sm text-gray-900">@Model.TenLoai</dd>
                        </div>
                        <div>
                            <dt class="text-sm font-medium text-gray-500">Tên loại Alias</dt>
                            <dd class="mt-1 text-sm text-gray-900">@(Model.TenLoaiAlias ?? "Không có")</dd>
                        </div>
                        <div>
                            <dt class="text-sm font-medium text-gray-500">Mô tả</dt>
                            <dd class="mt-1 text-sm text-gray-900">@(Model.MoTa ?? "Không có mô tả")</dd>
                        </div>
                    </div>
                </div>
                <!-- Hình ảnh -->
                <div>
                    <h2 class="text-lg font-semibold text-gray-900 mb-4">Hình ảnh</h2>
                    @if (!string.IsNullOrEmpty(Model.Hinh))
                    {
                        <img src="~/images/categories/@Model.Hinh" alt="@Model.TenLoai" class="max-w-[300px] w-full h-auto rounded" />
                    }
                    else
                    {
                        <p class="text-gray-500">Không có hình ảnh</p>
                    }
                </div>
            </div>

            <!-- Actions -->
            <div class="flex justify-end mt-6 space-x-4">
                <a asp-action="Edit" asp-route-id="@Model.MaLoai" class="inline-flex items-center px-4 py-2 rounded-lg bg-yellow-500 text-white hover:bg-yellow-600 transition-colors text-sm">
                    <i class="fas fa-edit mr-2"></i>Chỉnh sửa
                </a>
                <a asp-action="Index" class="inline-flex items-center px-4 py-2 rounded-lg bg-gray-600 text-white hover:bg-gray-700 transition-colors text-sm">
                    <i class="fas fa-arrow-left mr-2"></i>Trở về danh sách
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
}