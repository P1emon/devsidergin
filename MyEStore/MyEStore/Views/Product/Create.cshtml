@model MyEStore.Entities.HangHoa
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Thêm sản phẩm mới";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="min-h-screen bg-gray-100 py-8 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
        <!-- Header -->
        <div class="bg-white shadow-lg rounded-xl overflow-hidden mb-6">
            <div class="bg-gradient-to-r from-blue-700 to-indigo-700 px-6 py-4">
                <h2 class="text-2xl font-semibold text-white text-center">
                    <i class="fas fa-plus mr-2"></i>Thêm sản phẩm mới
                </h2>
            </div>
        </div>

        <!-- Form -->
        <div class="bg-white shadow-lg rounded-xl p-6">
            <form asp-action="Create" enctype="multipart/form-data" class="space-y-6">
                <div asp-validation-summary="ModelOnly" class="text-red-600 text-sm"></div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <!-- Left Column -->
                    <div class="space-y-6">
                        <!-- Tên hàng hóa -->
                        <div>
                            <label asp-for="TenHh" class="block text-sm font-medium text-gray-700">Tên hàng hóa <span class="text-red-500">*</span></label>
                            <input asp-for="TenHh" class="w-full px-3 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 bg-gray-50 text-sm" required />
                            <span asp-validation-for="TenHh" class="text-red-600 text-xs"></span>
                        </div>

                        <!-- Tên Alias -->
                        <div>
                            <label asp-for="TenAlias" class="block text-sm font-medium text-gray-700">Tên Alias</label>
                            <input asp-for="TenAlias" class="w-full px-3 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 bg-gray-50 text-sm" />
                            <span asp-validation-for="TenAlias" class="text-red-600 text-xs"></span>
                            <p class="mt-1 text-xs text-gray-500">Để trống để tự động tạo từ tên sản phẩm</p>
                        </div>

                        <!-- Loại sản phẩm -->
                        <div>
                            <label asp-for="MaLoai" class="block text-sm font-medium text-gray-700">Loại sản phẩm <span class="text-red-500">*</span></label>
                            <select asp-for="MaLoai" class="w-full px-3 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 bg-gray-50 text-sm" asp-items="ViewBag.MaLoai" required>
                                <option value="">-- Chọn loại sản phẩm --</option>
                            </select>
                            <span asp-validation-for="MaLoai" class="text-red-600 text-xs"></span>
                        </div>

                        <!-- Nhà cung cấp -->
                        <div>
                            <label asp-for="MaNcc" class="block text-sm font-medium text-gray-700">Nhà cung cấp <span class="text-red-500">*</span></label>
                            <select asp-for="MaNcc" class="w-full px-3 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 bg-gray-50 text-sm" asp-items="ViewBag.MaNcc" required>
                                <option value="">-- Chọn nhà cung cấp --</option>
                            </select>
                            <span asp-validation-for="MaNcc" class="text-red-600 text-xs"></span>
                        </div>

                        <!-- Đơn giá -->
                        <div>
                            <label asp-for="DonGia" class="block text-sm font-medium text-gray-700">Đơn giá <span class="text-red-500">*</span></label>
                            <input asp-for="DonGia" type="number" min="0" class="w-full px-3 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 bg-gray-50 text-sm" required />
                            <span asp-validation-for="DonGia" class="text-red-600 text-xs"></span>
                        </div>
                    </div>

                    <!-- Right Column -->
                    <div class="space-y-6">
                        <!-- Mô tả đơn vị -->
                        <div>
                            <label asp-for="MoTaDonVi" class="block text-sm font-medium text-gray-700">Mô tả đơn vị</label>
                            <input asp-for="MoTaDonVi" class="w-full px-3 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 bg-gray-50 text-sm" />
                            <span asp-validation-for="MoTaDonVi" class="text-red-600 text-xs"></span>
                        </div>

                        <!-- Giảm giá -->
                        <div>
                            <label asp-for="GiamGia" class="block text-sm font-medium text-gray-700">Giảm giá (%)</label>
                            <input asp-for="GiamGia" type="number" min="0" max="100" value="0" class="w-full px-3 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 bg-gray-50 text-sm" />
                            <span asp-validation-for="GiamGia" class="text-red-600 text-xs"></span>
                        </div>

                        <!-- Số lượng -->
                        <div>
                            <label asp-for="SoLuong" class="block text-sm font-medium text-gray-700">Số lượng <span class="text-red-500">*</span></label>
                            <input asp-for="SoLuong" type="number" min="0" value="0" class="w-full px-3 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 bg-gray-50 text-sm" required />
                            <span asp-validation-for="SoLuong" class="text-red-600 text-xs"></span>
                        </div>

                        <!-- Ngày sản xuất -->
                        <div>
                            <label asp-for="NgaySx" class="block text-sm font-medium text-gray-700">Ngày sản xuất</label>
                            <input asp-for="NgaySx" type="date" class="w-full px-3 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 bg-gray-50 text-sm" />
                            <span asp-validation-for="NgaySx" class="text-red-600 text-xs"></span>
                        </div>

                        <!-- Hình ảnh -->
                        <div>
                            <label for="hinhFile" class="block text-sm font-medium text-gray-700">Hình ảnh</label>
                            <input id="hinhFile" name="hinhFile" type="file" class="w-full px-3 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 bg-gray-50 text-sm" accept="image/*" />
                        </div>
                    </div>
                </div>

                <!-- Mô tả -->
                <div>
                    <label asp-for="MoTa" class="block text-sm font-medium text-gray-700">Mô tả</label>
                    <textarea asp-for="MoTa" rows="5" class="w-full px-3 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 bg-gray-50 text-sm"></textarea>
                    <span asp-validation-for="MoTa" class="text-red-600 text-xs"></span>
                </div>

                <!-- Buttons -->
                <div class="flex justify-between">
                    <a asp-action="Index" class="inline-flex items-center px-4 py-2 rounded-lg bg-gray-500 text-white hover:bg-gray-600 transition-colors text-sm">
                        <i class="fas fa-arrow-left mr-2"></i>Quay lại danh sách
                    </a>
                    <button type="submit" class="inline-flex items-center px-4 py-2 rounded-lg bg-blue-600 text-white hover:bg-blue-700 transition-colors text-sm">
                        <i class="fas fa-save mr-2"></i>Tạo mới
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.6.0/dist/jquery.min.js"></script>
    <script>
        $(document).ready(function() {
            // Tự động tạo alias từ tên sản phẩm
            $('#TenHh').on('change', function() {
                if ($('#TenAlias').val() === '') {
                    var alias = $(this).val()
                        .toLowerCase()
                        .replace(/[^\w\s-]/g, '')
                        .replace(/\s+/g, '-');
                    $('#TenAlias').val(alias);
                }
            });
        });
    </script>
}