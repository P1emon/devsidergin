@model MyEStore.Entities.HangHoaChiTiet
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Chi tiết sản phẩm";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="min-h-screen bg-gray-100 py-8 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
        <!-- Header -->
        <div class="bg-white shadow-lg rounded-xl overflow-hidden mb-6">
            <div class="bg-gradient-to-r from-blue-700 to-indigo-700 px-6 py-4">
                <h2 class="text-2xl font-semibold text-white text-center">
                    <i class="fas fa-info-circle mr-2"></i>Chi tiết sản phẩm: @Model.HangHoa?.TenHh
                </h2>
            </div>
        </div>

        <!-- Content -->
        <div class="bg-white shadow-lg rounded-xl p-6">
            <dl class="grid grid-cols-1 sm:grid-cols-3 gap-x-4 gap-y-6">
                <dt class="text-sm font-medium text-gray-600">Công dụng:</dt>
                <dd class="sm:col-span-2 text-sm text-gray-900">@Html.Raw(Model.CongDung)</dd>

                <dt class="text-sm font-medium text-gray-600">Đối tượng sử dụng:</dt>
                <dd class="sm:col-span-2 text-sm text-gray-900">@Html.Raw(Model.DoiTuongSuDung)</dd>

                <dt class="text-sm font-medium text-gray-600">Quy cách đóng gói:</dt>
                <dd class="sm:col-span-2 text-sm text-gray-900">@Html.Raw(Model.QuyCachDongGoi)</dd>

                <dt class="text-sm font-medium text-gray-600">Thành phần:</dt>
                <dd class="sm:col-span-2 text-sm text-gray-900">@Html.Raw(Model.ThanhPhan)</dd>

                <dt class="text-sm font-medium text-gray-600">Công nghệ đặc biệt:</dt>
                <dd class="sm:col-span-2 text-sm text-gray-900">@Html.Raw(Model.CongNgheDacBiet)</dd>

                <dt class="text-sm font-medium text-gray-600">Lợi ích nổi bật:</dt>
                <dd class="sm:col-span-2 text-sm text-gray-900">@Html.Raw(Model.LoiIchNoiBat)</dd>

                <dt class="text-sm font-medium text-gray-600">Lưu ý:</dt>
                <dd class="sm:col-span-2 text-sm text-gray-900">@Html.Raw(Model.LuuY)</dd>
            </dl>

            <!-- Action Buttons -->
            <div class="mt-6 flex flex-wrap gap-3">
                <a asp-action="EditDetails" asp-route-id="@Model.MaHh" class="inline-flex items-center px-4 py-2 rounded-lg bg-yellow-500 text-white hover:bg-yellow-600 transition-colors text-sm">
                    <i class="fas fa-edit mr-2"></i>Chỉnh sửa
                </a>
                <a asp-action="DeleteDetails" asp-route-id="@Model.MaHh" class="inline-flex items-center px-4 py-2 rounded-lg bg-red-500 text-white hover:bg-red-600 transition-colors text-sm">
                    <i class="fas fa-trash mr-2"></i>Xóa
                </a>
                <a asp-action="Details" asp-route-id="@Model.MaHh" class="inline-flex items-center px-4 py-2 rounded-lg bg-blue-500 text-white hover:bg-blue-600 transition-colors text-sm">
                    <i class="fas fa-info-circle mr-2"></i>Xem thông tin sản phẩm
                </a>
                <a asp-action="Index" class="inline-flex items-center px-4 py-2 rounded-lg bg-gray-500 text-white hover:bg-gray-600 transition-colors text-sm">
                    <i class="fas fa-arrow-left mr-2"></i>Quay lại danh sách
                </a>
            </div>
        </div>
    </div>
</div>