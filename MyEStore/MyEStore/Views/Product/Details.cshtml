@model MyEStore.Entities.HangHoa
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Chi tiết sản phẩm";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="min-h-screen bg-gray-100 py-8 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
        <!-- Header -->
        <div class="bg-white shadow-lg rounded-xl overflow-hidden mb-6">
            <div class="bg-gradient-to-r from-blue-700 to-indigo-700 px-6 py-4">
                <h2 class="text-2xl font-semibold text-white text-center">
                    <i class="fas fa-info-circle mr-2"></i>Chi tiết sản phẩm
                </h2>
            </div>
        </div>

        <!-- Content -->
        <div class="bg-white shadow-lg rounded-xl p-6">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <!-- Product Image -->
                <div class="text-center">
                    @if (!string.IsNullOrEmpty(Model.Hinh))
                    {
                        <img src="~/Hinh/HangHoa/@Model.Hinh" alt="@Model.TenHh" class="max-h-[300px] w-auto mx-auto rounded-lg" />
                    }
                    else
                    {
                        <img src="~/Hinh/HangHoa/no-image.png" alt="No Image" class="max-h-[300px] w-auto mx-auto rounded-lg" />
                    }
                </div>

                <!-- Product Details -->
                <div class="md:col-span-2">
                    <h3 class="text-xl font-semibold text-gray-800 mb-4">@Model.TenHh</h3>
                    <hr class="mb-4">
                    <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-4 gap-y-2">
                        <dt class="text-sm font-medium text-gray-600">Mã sản phẩm:</dt>
                        <dd class="text-sm text-gray-900">@Model.MaHh</dd>

                        <dt class="text-sm font-medium text-gray-600">Tên Alias:</dt>
                        <dd class="text-sm text-gray-900">@Model.TenAlias</dd>

                        <dt class="text-sm font-medium text-gray-600">Loại sản phẩm:</dt>
                        <dd class="text-sm text-gray-900">@Model.MaLoaiNavigation?.TenLoai</dd>

                        <dt class="text-sm font-medium text-gray-600">Nhà cung cấp:</dt>
                        <dd class="text-sm text-gray-900">@Model.MaNccNavigation?.TenCongTy</dd>

                        <dt class="text-sm font-medium text-gray-600">Đơn giá:</dt>
                        <dd class="text-sm text-gray-900">@Model.DonGia?.ToString("N0") VNĐ</dd>

                        <dt class="text-sm font-medium text-gray-600">Giảm giá:</dt>
                        <dd class="text-sm text-gray-900">@Model.GiamGia%</dd>

                        <dt class="text-sm font-medium text-gray-600">Số lượng:</dt>
                        <dd class="text-sm text-gray-900">@Model.SoLuong</dd>

                        <dt class="text-sm font-medium text-gray-600">Đơn vị:</dt>
                        <dd class="text-sm text-gray-900">@Model.MoTaDonVi</dd>

                        <dt class="text-sm font-medium text-gray-600">Ngày sản xuất:</dt>
                        <dd class="text-sm text-gray-900">@Model.NgaySx.ToString("dd/MM/yyyy")</dd>

                        <dt class="text-sm font-medium text-gray-600">Ngày tạo:</dt>
                        <dd class="text-sm text-gray-900">@Model.NgayTao.ToString("dd/MM/yyyy HH:mm")</dd>

                        <dt class="text-sm font-medium text-gray-600">Số lần xem:</dt>
                        <dd class="text-sm text-gray-900">@Model.SoLanXem</dd>
                    </dl>
                </div>
            </div>

            <!-- Product Description -->
            <div class="mt-6">
                <h5 class="text-lg font-semibold text-gray-800 mb-2">Mô tả sản phẩm:</h5>
                <div class="p-4 bg-gray-50 rounded-lg">
                    @Html.Raw(Model.MoTa)
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="mt-6 flex flex-wrap gap-3">
                <a asp-action="Edit" asp-route-id="@Model.MaHh" class="inline-flex items-center px-4 py-2 rounded-lg bg-yellow-500 text-white hover:bg-yellow-600 transition-colors text-sm">
                    <i class="fas fa-edit mr-2"></i>Chỉnh sửa
                </a>
                <a asp-action="EditDetails" asp-route-id="@Model.MaHh" class="inline-flex items-center px-4 py-2 rounded-lg bg-blue-500 text-white hover:bg-blue-600 transition-colors text-sm">
                    <i class="fas fa-list-alt mr-2"></i>Chi tiết sản phẩm
                </a>
                <a asp-action="Index" class="inline-flex items-center px-4 py-2 rounded-lg bg-gray-500 text-white hover:bg-gray-600 transition-colors text-sm">
                    <i class="fas fa-arrow-left mr-2"></i>Quay lại danh sách
                </a>
            </div>
        </div>
    </div>
</div>